# general
alias c="clear"
alias ll='ls -laG'

alias python="python3"

alias vim="nvim"

# git
git_branch() {
  git rev-parse --abbrev-ref HEAD 2> /dev/null
}
alias gd="git diff"
alias gfo="git fetch origin"
alias gco="git checkout"
alias gf="git fetch"
alias gcom="git checkout main"
alias gcb="git checkout -b"
alias gbd="git branch -D"
alias glr="git pull origin main --rebase"
alias gss="git status -s"
alias ga.="git add . -u"
alias gp='git push origin "$(git_branch)"'
alias gpf='git push origin "$(git_branch)" --force-with-lease'
alias gl='git pull origin "$(git_branch)"'
alias gcmsg='git commit -m'
# add tracked files and commit with passed message
gcaa() {
    git add . -u
    git commit -m "$@"
}
alias cb="git rev-parse --abbrev-ref HEAD"
alias gch="git rev-parse HEAD"
alias gbdl="git for-each-ref --format '%(refname:short)' refs/heads | grep -v main | xargs git branch -D"

# php
alias cda="composer dump-autoload"
alias punit="./vendor/bin/phpunit"
alias mrs="php artisan migrate:refresh --seed"

# docker
alias di="docker images"
alias dps="docker ps"
alias dpsa="docker ps -a"
alias dcp="docker compose ps"
alias dcu="docker compose up -d"
alias dcb="docker compose build"
alias dcr="docker compose restart"
alias dcd="docker compose down"
alias dcl="docker compose logs"
# exec into container bash entrypoint
dce() {
    docker compose exec "$@" bash
}

# kubectl
alias k="kubectl"

# ip addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ifconfig | grep inet"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# linux updates
alias apt-up="sudo apt update && sudo apt upgrade"

alias pg-run="mage postgres & ; sleep 3 ; mage migrate seed ; fg"
alias gtok="gcloud auth print-access-token |tr -d '\n' | pbcopy"

# generate lowercase uuid
alias uuidgen='uuidgen | tr "[:upper:]" "[:lower:]"'

alias claude='claude --allow-dangerously-skip-permissions'
alias copilot="copilot --yolo"
# Launch claude in an sbx sandbox from the custom template.
# Reattach if a sandbox for this dir exists; else create it from the template.
# Every launch, merge host prefs (statusline, spinner verbs, editor mode, ...)
# into the settings.json sbx regenerates on create, and pin the model via env.
# hooks/model are dropped: host-specific (macOS osascript, host paths) or set via
# ANTHROPIC_MODEL. gopls-lsp is dropped because gopls isn't in the sandbox image.
sbxc() {
  local name="claude-$(basename "$PWD")"
  if ! sbx ls -q 2>/dev/null | grep -qx "$name"; then
    sbx run -t claude-custom:v1 --name "$name" -d claude >/dev/null || return
  fi
  jq 'del(.hooks, .model, .enabledPlugins["gopls-lsp@claude-plugins-official"]) | .env.ANTHROPIC_MODEL = "opus"' ~/.claude/settings.json \
    | sbx exec "$name" -- sh -c 'cat > /tmp/host.json && cd /home/agent/.claude && jq -s ".[0] * .[1]" settings.json /tmp/host.json > settings.tmp && mv settings.tmp settings.json && rm /tmp/host.json'
  # Vendor the statusline script referenced by statusLine.command into the sandbox.
  [ -f ~/.claude/statusline.sh ] && sbx exec "$name" -- sh -c 'rm -f /home/agent/.claude/statusline.sh && cat > /home/agent/.claude/statusline.sh' < ~/.claude/statusline.sh
  sbx run --name "$name"
}
